# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Also required to run the RLS isolation test: src/lib/supabase/rls.integration.test.ts
# (skipped automatically when this is unset).
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for transaction categorization (src/lib/categorize/claude.ts).
# Without it, uncategorized transactions just fall back to "Other".
ANTHROPIC_API_KEY=

# Resend API key for reminder emails (src/lib/email/resend.ts). Without it,
# reminders still show up in the cabinet, just no email is sent.
RESEND_API_KEY=

# Shared secret the daily reminders cron route checks via the Authorization
# header (see vercel.json). Required for /api/cron/reminders to respond.
CRON_SECRET=
