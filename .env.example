# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Also required to run the RLS isolation test: src/lib/supabase/rls.integration.test.ts
# (skipped automatically when this is unset).
SUPABASE_SERVICE_ROLE_KEY=
